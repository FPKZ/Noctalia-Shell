{
    "apps": [
        {
            "image-path": "desktop.png",
            "name": "Desktop",
            "prep-cmd": [
                {
                    "do": "sunshine-switch-monitor.sh reset",
                    "undo": "sunshine-switch-monitor.sh reset"
                }
            ]
        },
        {
            "image-path": "desktop.png",
            "name": "Desktop (Tela 2)",
            "prep-cmd": [
                {
                    "do": "sunshine-switch-monitor.sh set 2",
                    "undo": "sunshine-switch-monitor.sh reset"
                }
            ]
        },
        {
            "image-path": "desktop.png",
            "name": "Desktop (Tela 3)",
            "prep-cmd": [
                {
                    "do": "sunshine-switch-monitor.sh set 3",
                    "undo": "sunshine-switch-monitor.sh reset"
                }
            ]
        },
        {
            "detached": [
                "setsid steam steam://open/bigpicture"
            ],
            "image-path": "steam.png",
            "name": "Steam Big Picture",
            "prep-cmd": [
                {
                    "do": "",
                    "undo": "setsid steam steam://close/bigpicture"
                }
            ]
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}
